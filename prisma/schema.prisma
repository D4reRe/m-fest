generator client {
  // ESM-first
  provider   = "prisma-client" // rust-free and ESM
  // Rust-free
  engineType = "client"
  // No generation into node_modules
  output     = "./generated/prisma"
  runtime    = "vercel-edge"
}

// Ignore this error for Prisma 7
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum TeamRole {
  Leader
  Member
}

enum Education {
  SMA
  SMK
  D3
  S1
}

enum CompetitionName {
  PDC
  IPPC
  BCC
  STEM
}

enum Gender {
  Male
  Female
}

enum DocumentStatus {
  AWAITING_UPLOAD
  PENDING
  VERIFIED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  ACCEPTED
}

enum TeamStatus {
  NOT_REGISTERED
  PENDING
  ACCEPTED
}

model CompRegistration {
  id                String          @id @default(uuid())
  userId            String // Id User Leader
  leaderUserId      String?
  leaderEmail       String?
  leaderName        String?
  leaderPhoneNumber String?
  teamInstitution   String?
  teamName          String?
  teamId            String?         @unique // Specific Team to register
  paymentId         String          @unique // Specific Payment to register
  statusOrder       String?         @default("PENDING")
  teamStatus        TeamStatus?
  competitionName   CompetitionName

  submissionFileUrl       String?
  submissionFileKey       String?
  submissionFileCreatedAt DateTime @default(now())
  submissionFileUploaded  Boolean  @default(false)
  submissionFileSubmitted Boolean  @default(false)

  // STEM
  mentor String?

  user    User?   @relation(fields: [userId], references: [id]) // Leader
  team    Team?   @relation(fields: [teamId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [orderId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([teamId])
  @@index([paymentId])
  @@map("comp_registration")
}

model EventRegistration {
  id         String @id @default(uuid())
  event_name String
  userId     String

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("event_registration")
}

model User {
  id            String  @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  imageKey      String?

  gender      Gender?
  phoneNumber String?
  domicile    String?
  institution String?
  major       String?
  education   Education?
  semester    Int?
  birthDate   DateTime?
  role        Role       @default(USER)

  verified  Boolean    @default(false)
  documents Documents?

  team_member       TeamMember[]
  registration      CompRegistration[]
  eventRegistration EventRegistration[]

  payments Payment[]
  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email])
  @@index([id])
  @@map("user")
}

model Documents {
  id                   String  @id @default(cuid())
  userId               String  @unique
  identityCardImageUrl String?
  twibbonImageUrl      String?
  followIgImageUrl     String?

  identityCardImageKey String?
  twibbonImageKey      String?
  followIgImageKey     String?

  identityCardCreatedAt DateTime? @default(now())
  twibbonCreatedAt      DateTime? @default(now())
  followIgCreatedAt     DateTime? @default(now())

  identityCardStatus DocumentStatus? @default(AWAITING_UPLOAD)
  twibbonStatus      DocumentStatus? @default(AWAITING_UPLOAD)
  followIgStatus     DocumentStatus? @default(AWAITING_UPLOAD)

  identityCardVerified Boolean? @default(false)
  twibbonVerified      Boolean? @default(false)
  followIgVerified     Boolean? @default(false)

  status    VerificationStatus @default(NOT_SUBMITTED)
  user      User               @relation(fields: [userId], references: [id])
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId])
  @@index([id])
  @@map("documents")
}

model Team {
  id          String           @id @default(cuid())
  name        String?          @unique
  competition CompetitionName?
  paymentId   String?          @unique
  members     TeamMember[]

  leaderUserId      String?
  leaderEmail       String?
  leaderName        String?
  leaderPhoneNumber String?
  teamInstitution   String?

  teamStatus TeamStatus? @default(NOT_REGISTERED)
  status     String?     @default("PENDING") // This is equivalent of statusOrder (payment)
  payment    Payment?    @relation(fields: [paymentId], references: [orderId])

  registration CompRegistration?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([paymentId])
  @@index([leaderUserId])
  @@index([id])
  @@map("team")
}

model TeamMember {
  userId String
  teamId String

  name        String?
  email       String?
  institution String?

  role     TeamRole? // Leader or Member
  joinDate DateTime? @default(now())

  verified Boolean @default(false)

  user User? @relation(fields: [userId], references: [id])
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("team_member")
}

model Payment {
  id              String            @id @default(cuid())
  orderId         String            @unique
  user            User?             @relation(fields: [userId], references: [id])
  userId          String?
  status          String?           @default("PENDING")
  competition     String?
  registration    CompRegistration?
  team            Team?
  amount          Int
  paymentUrl      String?
  referenceDuitku String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([orderId])
  @@map("payment")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
